# Copie para .env e preencha. Em produção, defina todas as variáveis.

# Obrigatório em produção (gere uma chave segura, ex: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=sua-chave-secreta-aqui

# Hosts permitidos (separados por vírgula). Ex: .seudominio.com,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Debug (em produção use false)
DEBUG=false

# Opcional: python-dotenv para carregar .env em desenvolvimento
# pip install python-dotenv
